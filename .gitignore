# dependencies (huge folder — everyone re-installs it from package.json instead)
/node_modules

# next.js build output
/.next
/out

# next.js auto-generated types (regenerated on every build)
next-env.d.ts

# typescript incremental build cache
*.tsbuildinfo

# production build
/build

# environment secret files
.env
.env*.local

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# editor / OS junk
.DS_Store
*.pem
.vscode/*
